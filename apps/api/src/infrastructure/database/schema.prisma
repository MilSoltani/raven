generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int @id @default(autoincrement())
  name      String @db.VarChar(255)
  email     String @unique @db.VarChar(255)
  password  String? @db.VarChar(255)
  createdAt Int @db.Integer
  updatedAt Int? @db.Integer

  sessions Session[]
  createdTickets Ticket[] @relation("TicketCreator")
  assignedTickets Ticket[] @relation("TicketAgent")
}

model Session {
  id               Int      @id @default(autoincrement())
  userId           Int
  refreshTokenHash String   @unique
  isRevoked        Boolean  @default(false)
  expiresAt Int @db.Integer
  createdAt Int @db.Integer
  updatedAt Int? @db.Integer

  user             User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum TicketStatus {
  OPEN
  PENDING
  WORKING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Ticket {
  id          Int @id @default(autoincrement())
  creatorId   Int
  agentId     Int?
  subject     String @db.VarChar(512)
  description String @db.Text
  status      TicketStatus @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  createdAt Int @db.Integer
  updatedAt Int? @db.Integer

  creator User @relation("TicketCreator", fields: [creatorId], references: [id])
  agent   User? @relation("TicketAgent", fields: [agentId], references: [id])

  @@index([creatorId])
  @@index([agentId])
  @@index([status])
}