{
  "name": "raven",
  "type": "module",
  "version": "0.0.1",
  "description": "Ticket System",
  "author": "Milad Soltani",
  "scripts": {
    "dev:api": "cd api && npm run dev",
    "debug:api": "cd api && npm run debug",
    "generate": "cd api && prisma generate",
    "migrate:dev": "cd api && prisma migrate dev",
    "migrate:reset": "cd api && prisma migrate reset",
    "studio": "cd api && prisma studio",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepare": "husky"
  },
  "workspaces": [
    "api"
  ],
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "eslint": "^10.3.0",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2"
  },
  "nano-staged": {
    "*.{js,ts,vue,css}": "eslint --fix"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.3.0"
  }
}
