{
  "name": "xenon",
  "description": "Ticket System",
  "author": "Milad Soltani",
  "scripts": {
    "dev:web": "cd apps/web && npm run dev",
    "dev:api": "cd apps/api && npm run dev",
    "debug:api": "cd apps/api && npm run debug",
    "generate": "cd apps/api && prisma generate",
    "migrate:dev": "cd apps/api && prisma migrate dev",
    "migrate:reset": "cd apps/api && prisma migrate reset",
    "studio": "cd apps/api && prisma studio",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepare": "husky"
  },
  "nano-staged": {
    "*.{js,ts,tsx,css}": "eslint --fix"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "^3.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "@tanstack/eslint-plugin-query": "^5.100.9",
    "eslint": "^10.3.0",
    "eslint-plugin-format": "^2.0.1",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2"
  }
}
