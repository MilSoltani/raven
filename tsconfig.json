{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@raven/schemas": ["./packages/schemas/src/index.ts"],
      "@raven/web": ["./packages/database/src/main.ts"],
      "@raven/api": ["./apps/api/src/main.ts"]
    },
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true
  }
}
